{"ahadith":{"result":"<head>\n    <link rel=\"canonical\" href=\"https:\/\/dorar.net\/dorar_api.json\">\n<\/head>\n<div class=\"hadith\" style=\"text-align:justify;\">1 -   <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يُذنِبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> <span class=\"search-keys\">فيُحسِنُ<\/span> <span class=\"search-keys\">الطَّهورَ<\/span> ثمَّ يقومُ فيُصلِّي ثمَّ يستغفرُ اللهَ إلَّا غفر اللهُ له .  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> العراقي\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج الإحياء للعراقي\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4\/58\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[روي] مرفوعاً وموقوفاً<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">2 -  <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> <span class=\"search-keys\">فيُحسنُ<\/span> <span class=\"search-keys\">الطهورَ<\/span> ثم يقومُ فيُصلِّي ركعتَينِ ثم يستغفرُ اللهَ إلا غفر اللهُ له ثم قرأ هذه الآيةَ { وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً . . . } الآيةَ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الزيلعي\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج الكشاف\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1\/429\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[فيه] أسماء بن الحكم قال ابن حبان يخطئ وقال البزار مجهول<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">3 -   <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يُذنِبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> <span class=\"search-keys\">فيُحسِنَ<\/span> <span class=\"search-keys\">الطَّهورَ<\/span> ثمَّ يقومَ فيُصلِّيَ ركعتَيْن ثمَّ يستغفِرُ اللهَ إلَّا غَفَر له ثمَّ قرأ هذهِ الآيةَ { وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ وَمَنْ يَغْفِرُ الذُّنُوبَ إِلاَّ اللَّهُ وَلَمْ يُصِرُّوا عَلَى <span class=\"search-keys\">مَا<\/span> فَعَلُوا وَهُمْ يَعْلَمُونَ}  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> المنذري\n    <span class=\"info-subtitle\">المصدر:<\/span>  الترغيب والترهيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/385\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[إسناده صحيح أو حسن أو ما قاربهما]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">4 -  حَديثُ: صَلاةُ التَّوبةِ. يَعني حَديثَ عَليٍّ: كُنتُ إذا سَمِعتُ <span class=\"search-keys\">مِن<\/span> رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حَديثًا نَفَعَني اللهُ بما شاءَ مِنهُ، إذا حَدَّثَني عَنهُ غَيري استَحلَفتُه، فإذا حَلَفَ لي صَدَّقتُه، وإنَّ أبا بَكرٍ حَدَّثَني أنَّه سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّم قال: \"<span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">مِن<\/span> <span class=\"search-keys\">عَبدٍ<\/span> <span class=\"search-keys\">يُذنِبُ<\/span> <span class=\"search-keys\">ذَنبًا<\/span> <span class=\"search-keys\">فيُحسِنُ<\/span> <span class=\"search-keys\">الطُّهورَ<\/span> ثُمَّ يَقومُ فيُصَلِّي رَكعَتَينِ ثُمَّ يَستَغفِرُ اللهَ إلَّا غفرَ لهُ\".    .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن مفلح\n    <span class=\"info-subtitle\">المصدر:<\/span>  الفروع لابن مفلح\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/ 403\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >حسن<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">5 -  [عن علي] يقول كنت رجلًا إذا سمعتُ <span class=\"search-keys\">من<\/span> رسولِ اللهِ صلى اللهُ عليهِ وسلَّمَ حديثًا نفعني اللهُ منه بما شاء أن ينفعني وإذا حدثني أحدٌ <span class=\"search-keys\">من<\/span> أصحابِه استحلفته فإذا حلف لي صدقته قال وحدثني أبو بكرٍ وصدق أبو بكرٍ أنه قال سمعت رسولَ اللهِ صلى اللهُ عليهِ وسلَّمَ يقولُ <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> <span class=\"search-keys\">فيُحسِنُ<\/span> <span class=\"search-keys\">الطُّهورَ<\/span> ثم يقومُ فيصلي ركعتين ثم يستغفرُ اللهَ إلا غفر اللهُ له ثم قرأ هذه الآيةَ { وَالَّذِينَ إذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أنْفُسَهُمْ}  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> البخاري\n    <span class=\"info-subtitle\">المصدر:<\/span>  تهذيب السنن\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4\/383\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >لم يرو عن ابن أبي الحر إلا هذا الحديث وحديث آخر ولم يتابع<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">6 -  عن علي رضي الله عنه قال: كُنْتُ رَجُلا إِذَا سَمِعْتُ <span class=\"search-keys\">مِنْ<\/span> رَسُولِ اللهِ حَدِيثًا ‌نَفَعَنِي ‌اللهُ ‌بِهِ ‌بِمَا ‌شَاءَ ‌أَنْ ‌يَنْفَعَنِي، ‌وَإِذَا ‌حَدَّثَنِي ‌أَحَدٌ ‌<span class=\"search-keys\">مِنْ<\/span> ‌أَصْحَابِهِ ‌اسْتَحْلَفْتُهُ ‌فَإِذَا ‌حَلَفَ ‌لِي ‌صَدَّقْتُهُ، قَالَ: حَدَّثَنِي أَبُو بَكْرٍ، وَصَدَقَ أَبُو بَكْرٍ، أَنَّهُ قَالَ: سمعت رَسُول اللهِ صلى الله عليه وسلم يقول: <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يُذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> <span class=\"search-keys\">فيُحسنُ<\/span> <span class=\"search-keys\">الطُّهورَ<\/span>، ثم يقوم فيصلِّي ركعتَين، ثم يستغفرُ اللهَ؛ إلا غفر له، ثم قرأ هذه الآيةَ :  وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ  إلى آخرِ الآيةِ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح الترغيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1621\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">7 -  كنتُ رجلًا إذا سمعتُ <span class=\"search-keys\">من<\/span> رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ حديثًا نفعني اللهُ منه بما شاء أن ينفعَني وإذا حدَّثني أحدٌ <span class=\"search-keys\">من<\/span> أصحابِه استحلفتُه فإذا حلف لي صدَّقتُه قال وحدَّثني أبو بكرٍ وصدق أبو بكرٍ رضيَ اللهُ عنهُ أنه قال سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقول <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> <span class=\"search-keys\">فيحسنُ<\/span> <span class=\"search-keys\">الطُّهورَ<\/span> ثم يقومُ فيصلِّي ركعتَينِ ثم يستغفرُ اللهَ إلا غفر اللهُ له ثم قرأ هذه الآية ( واَلَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللهَ ) إلى آخر الآيةِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أبو داود\n    <span class=\"info-subtitle\">المصدر:<\/span>  سنن أبي داود\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1521\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >سكت عنه [وقد قال في رسالته لأهل مكة كل ما سكت عنه فهو صالح]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">8 -  [عن علي] يقول: كنتُ رجُلًا إذا سَمِعتُ <span class=\"search-keys\">مِن<\/span> رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حديثًا نفَعَني اللهُ منه بما شاء أنْ ينفَعَني، وإذا حدَّثَني أحدٌ <span class=\"search-keys\">مِن<\/span> أصحابِه استَحلَفتُه، فإذا حلَفَ لي صدَّقتُه، قال: وحدَّثَني أبو بَكْرٍ -وصدَقَ أبو بَكْرٍ- أنَّه قال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">مِن<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يُذنِبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> <span class=\"search-keys\">فيُحسِنُ<\/span> <span class=\"search-keys\">الطُّهورَ<\/span>، ثمَّ يقومُ فيُصلِّي ركعتينِ، ثمَّ يَستغفِرُ اللهَ، إلَّا غفَرَ اللهُ له، ثمَّ قرَأَ هذه الآيةَ: {وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ} إلى آخِرِ الآيةِ [آل عمران: 135].  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> شعيب الأرناؤوط\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج سنن أبي داود\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1521\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده حسن<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">9 -  عن أسماءَ بنِ الحَكَمِ الفزازي ، قالَ: سَمِعْتُ عليًّا رضيَ اللَّهُ عنهُ يقولُ: كنتُ رجلًا إذا سَمِعْتُ <span class=\"search-keys\">من<\/span> رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ حديثًا نفعَني اللَّهُ منهُ بما شاءَ أن ينفعَني، وإذا حدَّثَني أحدٌ <span class=\"search-keys\">من<\/span> أصحابِهِ استَحلفتُهُ، فإذا حلَفَ لي صدَّقتُهُ، قالَ: وحدَّثَني أبو بَكْرٍ وصدقَ أبو بَكْرٍ رضيَ اللَّهُ عنهُ، أنَّهُ قالَ: سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ يقولُ: <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">مِن<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span>، <span class=\"search-keys\">فيُحسنُ<\/span> <span class=\"search-keys\">الطُّهورَ<\/span>، ثمَّ يقومُ فيُصلِّي رَكْعتينِ، ثمَّ يستغفِرُ اللَّهَ، إلَّا غفرَ اللَّهُ لَهُ، ثمَّ قرأَ هذِهِ الآيةَ:  وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ  إلى آخرِ الآيةِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح أبي داود\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1521\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">10 -  <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> مؤمنٍ <span class=\"search-keys\">يذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> فيتوضَّأ <span class=\"search-keys\">فيحسنُ<\/span> <span class=\"search-keys\">الطهورَ<\/span> ثم يصلي ركعتين فيستغفرُ اللهَ تعالى إلا غفرَ اللهُ له.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن باز\n    <span class=\"info-subtitle\">المصدر:<\/span>  فتاوى نور على الدرب لابن باز\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  11\/85\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">11 -   <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يُذْنِبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> فيتوضأُ ، <span class=\"search-keys\">فيُحْسِنُ<\/span> <span class=\"search-keys\">الطُّهورَ<\/span> ثُمَّ يقومُ فيُصلِّي ركعتينِ ، ثُمَّ يستغفرُ اللهَ بذلكَ الذنبِ ، إلَّا غُفِرَ لَهُ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح الجامع\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  5738\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">12 -  <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">مِن<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يُذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> ثم يتطهرُ <span class=\"search-keys\">فيُحسنُ<\/span> <span class=\"search-keys\">الطهورَ<\/span> ثم يصلِّي ركعتينِ ثم يتوبُ للهِ <span class=\"search-keys\">من<\/span> ذنبِه إلا تاب اللهُ عليه  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن باز\n    <span class=\"info-subtitle\">المصدر:<\/span>  مجموع فتاوى ابن باز\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  226\/4\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[ثابت]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -  <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">مِن<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> ثم يتطهرُ <span class=\"search-keys\">فيُحسنُ<\/span> <span class=\"search-keys\">الطهورَ<\/span>، ثم يصلِّي ركعتينِ ثم يتوبُ للهِ <span class=\"search-keys\">من<\/span> ذنبِه إلا تاب اللهُ عليه  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن باز\n    <span class=\"info-subtitle\">المصدر:<\/span>  مجموع فتاوى ابن باز\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  421\/11\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[ثابت]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -  <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">مِن<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> ثم يتطهرُ <span class=\"search-keys\">فيحسنُ<\/span> <span class=\"search-keys\">الطهورَ<\/span>، ثم يصلِّي ركعتينِ ويتوبُ إلى اللهِ <span class=\"search-keys\">من<\/span> ذلك الذنبِ إلا قبِلَ توبتَه  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن باز\n    <span class=\"info-subtitle\">المصدر:<\/span>  مجموع فتاوى ابن باز\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  424\/11\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">15 -  <span class=\"search-keys\">ما<\/span> <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">عبدٍ<\/span> <span class=\"search-keys\">يُذنبُ<\/span> <span class=\"search-keys\">ذنبًا<\/span> ثم يتطهرُ <span class=\"search-keys\">فيحسنُ<\/span> <span class=\"search-keys\">الطهورَ<\/span> ، ثم يصلِّي ركعتين  ثم يتوبُ للَّهِ <span class=\"search-keys\">من<\/span> ذنبِه ، إلا تاب اللهُ عليهِ  .<\/div>\n\n<div class=\"hadit