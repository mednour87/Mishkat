an class=\"search-keys\">اللَّهِ<\/span>، حيَّ على الصَّلاةِ، حيَّ علَى الصَّلاةِ، حيَّ علَى الفلاحِ ، حيَّ على الفلاحِ ، قد قامَتِ الصَّلاةُ، قَد قامتِ الصَّلاةُ، <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span>، لا إلَهَ إلَّا <span class=\"search-keys\">اللَّهُ<\/span> وفي روايةٍ قال - في أوَّلِ الأذانِ: <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span>، <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span>، - وفي روايةٍ - <span class=\"search-keys\">وإذا<\/span> أقَمتَ فقُلها مرَّتَينِ: قَد قامَتِ الصَّلاةُ، قد قامَتِ الصَّلاةُ، أسمعتَ؟ - وفيها زِيادةٌ - : فَكانَ أبو مَحذورةَ لا يَجزُّ ناصيتَهُ، ولا يفرقُها؛ لأنَّ رسولَ <span class=\"search-keys\">اللَّهِ<\/span> صلَّى <span class=\"search-keys\">اللَّهُ<\/span> عليهِ وسلَّمَ مسحَ عَليها]  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو محذورة سمرة بن معير<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن القطان\n    <span class=\"info-subtitle\">المصدر:<\/span>  الوهم والإيهام\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4\/148\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >هو من رواية عثمان بن السائب عن أبيه وأم عبد الملك ابن أبي محذورة كلهم غير معروفين<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">10 -   جاء رجلٌ بدويٌّ إلى رسولِ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّم فقال يا رسولَ <span class=\"search-keys\">اللهِ<\/span> علِّمْني خيرًا قال قلْ سبحانَ <span class=\"search-keys\">اللهِ<\/span> والحمدُ للهِ ولا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> واللهُ <span class=\"search-keys\">أكبرُ<\/span> قال وعقد بيدِه أربعًا ثمَّ ذهب فقال سبحانَ <span class=\"search-keys\">اللهِ<\/span> والحمدُ للهِ ولا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> واللهُ <span class=\"search-keys\">أكبُر<\/span> ثمَّ <span class=\"search-keys\">رجع<\/span> فلمَّا رآه رسولُ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّم تبسَّم وقال تفكُّرُ البائسِ فقال يا رسولَ <span class=\"search-keys\">اللهِ<\/span> سبحانَ <span class=\"search-keys\">اللهِ<\/span> والحمدُ للهِ ولا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> واللهُ <span class=\"search-keys\">أكبرُ<\/span> هذا كلُّه للهِ فما لي فقال رسولُ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّم <span class=\"search-keys\">إذا<\/span> قلتَ سبحانَ <span class=\"search-keys\">اللهِ<\/span> قال <span class=\"search-keys\">اللهُ<\/span> صدقتَ <span class=\"search-keys\">وإذا<\/span> قلتَ الحمدُ للهِ قال <span class=\"search-keys\">اللهُ<\/span> صدقتَ <span class=\"search-keys\">وإذا<\/span> قلتَ لا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> قال <span class=\"search-keys\">اللهُ<\/span> صدقتَ <span class=\"search-keys\">وإذا<\/span> قلتَ <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> قال <span class=\"search-keys\">اللهُ<\/span> صدقتَ فتقولُ اللَّهمَّ اغفرْ لي فيقولُ <span class=\"search-keys\">اللهُ<\/span> قد فعلتُ فتقولُ اللَّهمَّ ارحمْني فيقولُ <span class=\"search-keys\">اللهُ<\/span> قد فعلتُ وتقولُ اللَّهمَّ ارزقْني فيقولُ <span class=\"search-keys\">اللهُ<\/span> قد فعلتُ قال فعقد الأعرابيُّ سبعًا في يدِه  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس بن مالك<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> المنذري\n    <span class=\"info-subtitle\">المصدر:<\/span>  الترغيب والترهيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/354\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[ لا يتطرق إليه احتمال التحسين]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">11 -   علَّمَني رسولُ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليهِ وسلَّمَ الأذانَ تسعَ عشرةَ كلمةً : <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">أكبرُ<\/span> ، <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">أكبرُ<\/span> <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">أكبرُ<\/span> ، الحديث وفيه : التَّرجيعُ ، والإقامةُ سبعَ عشرةَ كلمةً : <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">أكبرُ<\/span> <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">أكبرُ<\/span> ، <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">أكبرُ<\/span> <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">أكبرُ<\/span> ، الحديث وفيه : تثنيةُ التشهُّدَينِ ، والحَيَّعَلَتينِ ، وقد قامت الصلاةُ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو محذورة سمرة بن معير<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن دقيق العيد\n    <span class=\"info-subtitle\">المصدر:<\/span>  الإلمام بأحاديث الأحكام\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1\/135\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >أخرجه ابن ماجه عن رجال الصحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">12 -   <span class=\"search-keys\">إذا<\/span> قال المؤذِّنُ : <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> غُلِّقتْ أبوابُ النِّيرانِ ، <span class=\"search-keys\">وإذا<\/span> قال : أشهدُ أن لا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> فُتِّحتْ أبوابُ الجِنانِ ، <span class=\"search-keys\">وإذا<\/span> قال : أشهدُ أنَّ محمَّدًا رسولُ <span class=\"search-keys\">اللهِ<\/span> تبادرت الحورُ إلى أبوابِ الجِنانِ شوقًا إلى ذكرِ محمَّدٍ ، فإذا قال : حيَّ على الصَّلاةِ تُحشْحِشُ ثمارُ الجنَّةِ ، فإذا قال : حيَّ على الفلاحِ نادَى منادٍ من السَّماءِ : يا بنَ آدمَ أفلحتَ وأفلحَ من أجابك ، فإذا قال : <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> تقولُ ملائكةُ سبعِ سماواتٍ : أيُّها العبدُ كبَّرتَ كبيرًا وعظَّمتَ عظيمًا <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> ، وأعظمُ ممَّا يصِفُه الواصفون ، فإذا قال : لا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> يقولُ <span class=\"search-keys\">اللهُ<\/span> عزَّ وجلَّ : صدق عبدي بها حرَّمتُ بدنَك وبدنَ من أجابك على النَّارِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عباس<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن الجوزي\n    <span class=\"info-subtitle\">المصدر:<\/span>  الموضوعات لابن الجوزي\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/376\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >أورده في كتاب الموضوعات<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -  أنَّ النَّبيَّ صلَّى <span class=\"search-keys\">اللَّهُ<\/span> عليهِ وسلَّمَ علَّمَهُ الأذانَ تِسعَ عَشرةَ كلمةً <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو محذورة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> العيني\n    <span class=\"info-subtitle\">المصدر:<\/span>  نخب الافكار\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3\/16\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[ورد] من أربع طرق صحاح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -  أنَّ رَسولَ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّم كان <span class=\"search-keys\">إذا<\/span> سَمِعَ المؤذِّنَ يقولُ: <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبَرُ<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبَرُ<\/span>، قال مِثْلَ مَقالتِه، <span class=\"search-keys\">وإذا<\/span> قال: أشهَدُ أنْ لا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span>، قال مِثلَ ما يقولُ، <span class=\"search-keys\">وإذا<\/span> قال: أشهَدُ أنَّ مُحَمَّدًا رَسولُ <span class=\"search-keys\">اللهِ<\/span>، قال مِثلَ قَولِه.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> معاوية بن أبي سفيان<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن كثير\n    <span class=\"info-subtitle\">المصدر:<\/span>  الأحكام الكبير\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1\/215\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده جيد<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">15 -  أنَّ رسولَ  <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّمَ كان <span class=\"search-keys\">إذا<\/span> سمِعَ المؤذِّنَ يقولُ: <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أَكبَرُ<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أَكبَرُ<\/span>، قال مِثلَ قَولِه، <span class=\"search-keys\">وإذا<\/span> قال: أَش