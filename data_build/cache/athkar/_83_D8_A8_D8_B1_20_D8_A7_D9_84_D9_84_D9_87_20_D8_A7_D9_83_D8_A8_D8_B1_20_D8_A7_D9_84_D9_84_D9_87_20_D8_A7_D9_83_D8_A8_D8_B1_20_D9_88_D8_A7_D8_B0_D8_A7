pan class=\"search-keys\">وإذا<\/span> قال : أشهدُ أنَّ محمَّدًا رسولُ <span class=\"search-keys\">اللهِ<\/span> تبادرت الحورُ إلى أبوابِ الجِنانِ شوقًا إلى ذكرِ محمَّدٍ ، فإذا قال : حيَّ على الصَّلاةِ تُحشْحِشُ ثمارُ الجنَّةِ ، فإذا قال : حيَّ على الفلاحِ نادَى منادٍ من السَّماءِ : يا بنَ آدمَ أفلحتَ وأفلحَ من أجابك ، فإذا قال : <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> تقولُ ملائكةُ سبعِ سماواتٍ : أيُّها العبدُ كبَّرتَ كبيرًا وعظَّمتَ عظيمًا <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبرُ<\/span> ، وأعظمُ ممَّا يصِفُه الواصفون ، فإذا قال : لا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> يقولُ <span class=\"search-keys\">اللهُ<\/span> عزَّ وجلَّ : صدق عبدي بها حرَّمتُ بدنَك وبدنَ من أجابك على النَّارِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عباس<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن الجوزي\n    <span class=\"info-subtitle\">المصدر:<\/span>  الموضوعات لابن الجوزي\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/376\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >أورده في كتاب الموضوعات<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">5 -  أنَّ النَّبيَّ صلَّى <span class=\"search-keys\">اللَّهُ<\/span> عليهِ وسلَّمَ علَّمَهُ الأذانَ تِسعَ عَشرةَ كلمةً <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">أَكْبرُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو محذورة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> العيني\n    <span class=\"info-subtitle\">المصدر:<\/span>  نخب الافكار\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3\/16\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[ورد] من أربع طرق صحاح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">6 -  أنَّ رَسولَ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّم كان <span class=\"search-keys\">إذا<\/span> سَمِعَ المؤذِّنَ يقولُ: <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبَرُ<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أكبَرُ<\/span>، قال مِثْلَ مَقالتِه، <span class=\"search-keys\">وإذا<\/span> قال: أشهَدُ أنْ لا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span>، قال مِثلَ ما يقولُ، <span class=\"search-keys\">وإذا<\/span> قال: أشهَدُ أنَّ مُحَمَّدًا رَسولُ <span class=\"search-keys\">اللهِ<\/span>، قال مِثلَ قَولِه.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> معاوية بن أبي سفيان<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن كثير\n    <span class=\"info-subtitle\">المصدر:<\/span>  الأحكام الكبير\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1\/215\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده جيد<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">7 -  أنَّ رسولَ  <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّمَ كان <span class=\"search-keys\">إذا<\/span> سمِعَ المؤذِّنَ يقولُ: <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أَكبَرُ<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">أَكبَرُ<\/span>، قال مِثلَ قَولِه، <span class=\"search-keys\">وإذا<\/span> قال: أَشهَدُ أنْ لا إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span>، قال مِثلَ قَولِه، <span class