{"ahadith":{"result":"<head>\n    <link rel=\"canonical\" href=\"https:\/\/dorar.net\/dorar_api.json\">\n<\/head>\n<div class=\"hadith\" style=\"text-align:justify;\">1 -  أنَّ <span class=\"search-keys\">النَّبيَّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> كان يصلِّي على ناقتِه <span class=\"search-keys\">القَصواءِ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبد الله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الدارقطني\n    <span class=\"info-subtitle\">المصدر:<\/span>  علل الدارقطني\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2917\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >رواه أحمدُ بنُ سَعيدِ بنِ شاهينَ، عن مُصعَبٍ الزُّبَيريِّ، عن الدَّراوَرْديِّ، فقال: عن ابنِ يزيدَ، عن عبدِ اللهِ بنِ قُسَيطٍ، عن نافعٍ، عن ابنِ عُمَرَ، ووَهِمَ في نسَبِه، وإنما هو: يزيدُ بنُ عبدِ اللهِ بنِ أسامةَ بنِ الهادِ.\nوكذلك رواه الدَّراوَرْديُّ وحَيوةُ عنه<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">2 -  رأيتُ <span class=\"search-keys\">النَّبيَّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> على ناقتِهِ <span class=\"search-keys\">القصواءِ<\/span> يهلُّ والنَّاسُ يُميلُ بعضُهم بعضًا يريدونَ أن ينظروا إليهِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عامر بن واثلة أبو الطفيل<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الهيثمي\n    <span class=\"info-subtitle\">المصدر:<\/span>  مجمع الزوائد\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3\/226\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >فيه محمد بن مهزم ولم يجرحه أحد وقد ذكره ابن أبي حاتم وبقيه رجاله رجال الصحيح‏‏<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">3 -   كانت ناقةُ رسولِ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> <span class=\"search-keys\">القصواءَ<\/span> لا تُدفَعُ في سباقٍ إلا قال سعيدُ بنُ المُسيِّبِ سُبِقتْ ناقةُ رسولِ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلِّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> وبلغ ذلك <span class=\"search-keys\">النبيَّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> فقال إنَّ الناسَ لم يرفعوا شيئًا من الدُّنيا إلا وضعَه <span class=\"search-keys\">اللهُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن العربي\n    <span class=\"info-subtitle\">المصدر:<\/span>  عارضة الأحوذي\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4\/159\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >طرقه كثيرة<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">4 -  طافَ رسولُ <span class=\"search-keys\">اللَّهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> على راحلتِهِ <span class=\"search-keys\">القَصواءَ<\/span> يومَ الفَتحِ ليستلِمَ الرُّكنَ بمحجنِهِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن خزيمة\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح ابن خزيمة\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4\/ 416\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >أخرجه في صحيحه<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">5 -  حديثُ سعيدِ بنِ المُسيَّبِ، عن أبي هُرَيرةَ: أنَّ <span class=\"search-keys\">القَصواءَ<\/span> ناقةَ رسولِ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> كانت لا تُدفَعُ في السِّباقِ إلَّا سبقَت، <span class=\"search-keys\">حتَّى<\/span> وقعَت يومًا في السِّباقِ فسُبِقَت، فكرِه النَّاسُ ذلك، فقال رسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span>: إنَّ النَّاسَ إذا رفَعوا شيئًا وضَعه <span class=\"search-keys\">اللهُ<\/span>!  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الدارقطني\n    <span class=\"info-subtitle\">المصدر:<\/span>  علل الدارقطني\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1697\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >يرويه مالِكٌ، عن الزُّهريِّ، واختُلِف عنه؛ فرواه مَعنُ بنُ عيسى، عن مالِكٍ، عن الزُّهريِّ، عن سعيدٍ، عن أبي هُرَيرةَ. وكذلك رُوِي عن النَّضرِ بنِ طاهِرٍ، عن مالِكٍ. ورواه مُحمَّدُ بنُ الحَسنِ، عن مالِكٍ، عن الزُّهريِّ، عن سعيدٍ مُرسَلًا. وكذلك رواه أصحابُ &quot;المُوطَّأِ&quot;، عن مالِكٍ. وكذلك رواه ابنُ وَهبٍ، عن يونُسَ، ومالِكٍ.\nوكذلك رواه يحيى بنُ سعيدٍ الأنصاريُّ، عن الزُّهريِّ، عن سعيدٍ مُرسَلًا، والمُرسَلُ أصَحُّ.<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">6 -   خرج رسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> وخرجنا معه ، <span class=\"search-keys\">حتَّى<\/span> أتينا ذا الحُلَيفةِ ، ثمَّ قال : فصلَّى رسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> في المسجدِ ثمَّ ركِب <span class=\"search-keys\">القصواءَ<\/span> ، <span class=\"search-keys\">حتَّى<\/span> استوَتْ ناقتُه على البيداءِ ، ثمَّ قال : ورسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> بين أظهُرِنا وعليه ينزِلُ القرآنَ ، وهو يعلمُ تأويلَه ، فما عمِل شيئًا ممَّا عمِلناه ، فأهلَّ رسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> بالتَّوحيدِ : لبَّيْك اللَّهمَّ لبَّيْك وذكر باقيَ التَّلبيةِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> جابر بن عبدالله<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن حزم\n    <span class=\"info-subtitle\">المصدر:<\/span>  حجة الوداع\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  458\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">7 -  حَديثٌ رَواه مَعْنُ بنُ عيسى، عن مالِكٍ، عن الزُّهْريِّ، عن سَعيدِ بنِ المُسَيَّبِ، عن أبي هُرَيْرةَ، قالَ: كانَت <span class=\"search-keys\">القَصْواءُ<\/span> ناقةُ رَسولِ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> لا تُدفَعُ في سِباقٍ إلَّا سَبَقَتْ.\nورَواه يونُسُ بنُ يَزيدَ، عن الزُّهْريِّ، عن سَعيدِ بنِ المُسَيَّبِ -ولم يُجاوِزْ به- أنَّ <span class=\"search-keys\">القَصْواءَ<\/span> ناقةَ رَسولِ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> لا تُدفَعُ في سِباقٍ إلَّا سَبَقَتْ؟  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أبو زرعة الرازي\n    <span class=\"info-subtitle\">المصدر:<\/span>  علل ابن أبي حاتم\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1914\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >الصَّحيحُ: عن الزُّهْريِّ عن سَعيدٍ فقط.<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">8 -  أنَّ امرأةَ أبي ذرٍّ جاءت على <span class=\"search-keys\">القَصواءِ<\/span> راحلةِ رسولِ <span class=\"search-keys\">اللَّهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> <span class=\"search-keys\">حتَّى<\/span> أَناخت عندَ المسجدِ فقالَت : يا رسولَ <span class=\"search-keys\">اللَّهِ<\/span> نذرتُ لئن نجَّاني <span class=\"search-keys\">اللَّهُ<\/span> عليها لآكلنَّ من كبدِها وسَنامِها قالَ : بئسَ ما جزيتِها ليسَ هذا نذرًا إنَّما النَّذرُ ما ابتُغِيَ بِهِ وجهُ <span class=\"search-keys\">اللَّهِ<\/span> .  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> [جد عمرو بن شعيب]<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الذهبي\n    <span class=\"info-subtitle\">المصدر:<\/span>  المهذب في اختصار السنن\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  8\/4051\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده صالح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">9 -   أنَّ امرأةَ أبي ذرٍّ جاءت على <span class=\"search-keys\">القصواءِ<\/span> راحلةِ رسولِ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> <span class=\"search-keys\">حتى<\/span> أناختْ عند المسجدِ فقالت يا رسولَ <span class=\"search-keys\">اللهِ<\/span> نذرتُ لئن نجَّاني <span class=\"search-keys\">اللهُ<\/span> عليها لآكلَنَّ من كبدِها وسِنامِها قال بئسما جزيتِيها ليس هذا نذرٌ إنما النذرُ ما ابتُغِيَ به وجهُ <span class=\"search-keys\">اللهِ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> [جد عمرو بن شعيب]<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  السلسلة الصحيحة\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  7\/905\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده حسن<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">10 -  عن [ أبي جعفرٍ محمَّدِ بنِ عليٍّ] قالَ: دخَلنا على جابرٍ فقُلتُ: أخبرني عَن حجَّةِ رسولِ <span class=\"search-keys\">اللَّهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span>... فذَكَرَ بعضَ الحديثِ، وقالَ: رَكِبَ <span class=\"search-keys\">القَصواءَ<\/span> <span class=\"search-keys\">حتَّى<\/span> أتَى الموقِفَ فجعلَ بطنَ ناقتِهِ إلى الصَّخراتِ، وجعلَ حبلَ المشاةِ بينَ يدَيهِ واستَقبلَ القبلةَ، فلم يزَل واقفًا <span class=\"search-keys\">حتَّى<\/span> غربتِ الشَّمسُ وذَهَبتِ الصُّفرةُ قليلًا حينَ غابَ القُرصُ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> جابر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن خزيمة\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح ابن خزيمة\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4\/ 442\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >أخرجه في صحيحه<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">11 -   عن ابن عمرَ قال : أٌنزِلتْ { إِذَا جَاءَ نَصْرُ <span class=\"search-keys\">اللهِ<\/span> } على <span class=\"search-keys\">النبي<\/span> <span class=\"search-keys\">صلى<\/span> <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلم<\/span> في وسطِ أيامِ التشريق وعرفَ أنه الوداعُ فأمر براحلتهِ <span class=\"search-keys\">القصواءُ<\/span> فرُحّلَتْ <span class=\"search-keys\">له<\/span> فركبَ فوقفَ بالعقبةِ واجتمعَ الناسُ فقال : يا أيها الناسُ ، يا أيها الناسُ . . وذكر الحديثَ في خطبتِه .  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الذهبي\n    <span class=\"info-subtitle\">المصدر:<\/span>  المهذب في اختصار السنن\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4\/1903\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >فيه موسى واه<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">12 -  طافَ رسولُ <span class=\"search-keys\">اللَّهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">علَيهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> علَى راحلَتِهِ <span class=\"search-keys\">القَصواءِ<\/span> يومَ الفَتحِ واستلمَ الرُّكنَ بمِحجنِهِ وما وجدَ لَها مُناخًا في المسجدِ <span class=\"search-keys\">حتَّى<\/span> أُخرِجَت إلى بَطنِ الوادي فأُنيخَت ثمَّ حمِدَ <span class=\"search-keys\">اللَّهَ<\/span> وأثنَى <span class=\"search-keys\">علَيهِ<\/span> ، ثمَّ قالَ : أمَّا بعدُ أيُّها النَّاسُ فإنَّ <span class=\"search-keys\">اللَّهَ<\/span> قد أذهبَ عنكُم عَيبَةَ الجاهليَّةِ ، النَّاسُ رجلانِ : بَرٌّ تَقيٌّ كريمٌ علَى ربِّهِ . . .  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  السلسلة الصحيحة\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  6\/719\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -  أقبل <span class=\"search-keys\">النبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> عامَ الفتحِ وهو مُردفٌ أسامةَ على <span class=\"search-keys\">القَصواءِ<\/span> ، ومعه بلالٌ وعثمانُ بنُ طلحةَ الحجبيُّ ، <span class=\"search-keys\">حتى<\/span> أناخ عندَ البيتِ ، ثم قال لعثمانَ : ائتنا بمِفتاحٍ ، فجاءه بالمِفتاحِ ففتَح <span class=\"search-keys\">له<\/span> البابَ فدخل <span class=\"search-keys\">النبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> وأسامةُ وبلالٌ وعثمانُ ، ثم أغلقوا عليهم البابَ ، فمكث نهارًا طويلًا ثم خرج ، وابتدَر الناسُ الدخولَ ، فسبقتُهم فوجدتُ بلالًا قائمًا وراءَ البابِ ، فقلتُ <span class=\"search-keys\">له<\/span> : أينَ <span class=\"search-keys\">صلى<\/span> <span class=\"search-keys\">النبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> ؟ قال : <span class=\"search-keys\">صلى<\/span> بينَ العمودينَ المقدَّمَينِ ، وكان البيتُ على ستةِ أعمدةٍ شطرينِ <span class=\"search-keys\">صلى<\/span> بين العمودين من الشطرِ المقدَّمِ ، وجعَل بابَ البيتِ خلفَ ظهرِه ، فاستقبل بوجهِه الذي يستقبلُك حين تَلِجُ البيتَ بينَه وبينَ الجدارِ ، قال : ونسيتُ أنْ أسأله كمْ <span class=\"search-keys\">صلَّى<\/span> ، وعندَ المكانِ الذي <span class=\"search-keys\">صلى<\/span> فيهِ مَرْمَرَةٌ حمراءُ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> البيهقي\n    <span class=\"info-subtitle\">المصدر:<\/span>  السنن الكبرى للبيهقي\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/327\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >ثابت<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -   كان فَرسُ رسولِ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> يقالُ <span class=\"search-keys\">له<\/span> : المُرتَجِزُ ، وبغلتُه يقالُ لها : دَلدَلٌ ، وحمارُه يقالُ <span class=\"search-keys\">له<\/span> : عُفَيرُ وسيفُه يقالُ <span class=\"search-keys\">له<\/span> : ذُو الفَقارِ ، ودِرعُه ذاتُ الفُضولِ ، وناقتُه <span class=\"search-keys\">القَصواءُ<\/span> .  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> علي بن أبي طالب<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الذهبي\n    <span class=\"info-subtitle\">المصدر:<\/span>  المهذب في اختصار السنن\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  8\/3992\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >فيه حبان ضعيف<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">15 -  أقبَلَ <span class=\"search-keys\">النَّبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> عامَ الفَتحِ وهو مُردِفٌ أُسامةَ على <span class=\"search-keys\">القَصواءِ<\/span>، ومعهُ بلالٌ، وعُثمانُ بنُ طَلحةَ، <span class=\"search-keys\">حتَّى<\/span> أناخَ عِندَ البَيتِ، ثُمَّ قال لعُثمانَ: ائتِنا بالمِفتاحِ. فجاءَه بالمِفتاحِ ففَتَحَ <span class=\"search-keys\">له<\/span> البابَ، فدَخَلَ <span class=\"search-keys\">النَّبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> وأُسامةُ، وبلالٌ، وعُثمانُ، ثُمَّ أغلَقوا عليهمُ البابَ، فمَكَثَ نَهارًا طَويلًا، ثُمَّ خَرَجَ وابتَدَرَ النَّاسُ الدُّخولَ، فسَبَقتُهم، فوجَدتُ بلالًا قائِمًا مِن وراءِ البابِ، فقُلتُ <span class=\"search-keys\">له<\/span>: أينَ <span class=\"search-keys\">صَلَّى<\/span> رَسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span>؟ فقال: <span class=\"search-keys\">صَلَّى<\/span> بينَ ذَينِك العَمودَينِ المُقدَّمَينِ، وكان البَيتُ على سِتَّةِ أعمِدةٍ سَطرَينِ، <span class=\"search-keys\">صَلَّى<\/span> بينَ العَمودَينِ مِنَ السَّطرِ المُقدَّمِ، وجَعَلَ بابَ البَيتِ خَلفَ ظَهرِه، واستَقبَلَ بوجهِه الذي يَستَقبِلُك حينَ تَلِجُ البَيتَ بينَه وبينَ الجِدارِ، قال: ونَسيتُ أن أسألَه كَم <span class=\"search-keys\">صَلَّى<\/span>؟ وعِندَ المَكانِ الذي <span class=\"search-keys\">صَلَّى<\/span> فيه مَرمَرةٌ حَمراءُ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> البخاري\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح البخاري\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4400\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[صحيح]<\/span>\n<\/div>\n--------------\n<br\/>\n<br\/><br\/>\n<a href=\"https:\/\/dorar.net\/hadith\/search?q=النبي صلي الله عليه وسلم القصواء حتي\">المزيد<\/a>\n"}}