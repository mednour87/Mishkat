ى اللهُ عليه <span class=\"search-keys\">وسلَّم<\/span> إذا أتاه رَجُلٌ بصَدَقةٍ قال: <span class=\"search-keys\">اللهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ فُلانٍ، فأتاه أبي فقال: <span class=\"search-keys\">اللهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ أبي أوفى.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> البخاري\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح البخاري\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  6332\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[صحيح]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">6 -  كان النَّبيُّ صلَّى اللهُ عليه <span class=\"search-keys\">وسلَّم<\/span> إذا أتاه قَومٌ بصَدَقَتِهم، قال: <span class=\"search-keys\">اللهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ فُلانٍ، فأتاه أبي بصَدَقَتِه، فقال: <span class=\"search-keys\">اللهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ أبي أوفى.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> البخاري\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح البخاري\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1497\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[صحيح]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">7 -  كان النَّبيُّ صلَّى اللهُ عليه <span class=\"search-keys\">وسلَّم<\/span> إذا أتاه قَومٌ بصَدَقَتِهم، قال: «<span class=\"search-keys\">اللهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ فُلانٍ»، فأتاه أبي بصَدَقَتِه، فقال: «<span class=\"search-keys\">اللهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ أبي أوفى»  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبد الله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> البيهقي\n    <span class=\"info-subtitle\">المصدر:<\/span>  معرفة السنن والآثار\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  8412\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >ثابت<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">8 -   كان رسولُ اللهِ صلَّى اللهُ عليه <span class=\"search-keys\">وسلَّم<\/span> إذا دخل المسجدَ قال : بسمِ اللهِ <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">على<\/span> محمَّدٍ ، وإذا خرج قال : بسمِ اللهِ <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">على<\/span> محمَّدٍ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس بن مالك<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> السخاوي\n    <span class=\"info-subtitle\">المصدر:<\/span>  القول البديع\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  267\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >في سنده من لا يعرف<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">9 -  كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ <span class=\"search-keys\">وسلَّمَ<\/span> إذا أتاهُ قومٌ بصدَقتِهم قالَ <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ فلانٍ فأتاهُ أبي بصدَقتِهِ فقالَ <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ أبي أوفَى  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح النسائي\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2458\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">10 -  كان النَّبيُّ صلَّى اللهُ عليه <span class=\"search-keys\">وسلَّمَ<\/span> إذا أتاه رَجُلٌ بصَدقتِه، قال: <span class=\"search-keys\">اللَّهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ فُلانٍ، قال: فأتاه أبي بصَدقتِه، فقال: <span class=\"search-keys\">اللَّهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ أبي أَوفى.   .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> شعيب الأرناؤوط\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج المسند لشعيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  19416\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده صحيح على شرط الشيخين<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">11 -  كانَ رَسولُ اللهِ صلَّى اللهُ عليه <span class=\"search-keys\">وسلَّم<\/span> إذا أتاه قَومٌ بصَدَقَتِهم، قال: <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> عليهم، فأتاه أبي أبو أوفى بصَدَقَتِه، فقال: <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ أبي أوفى. [وفي روايةٍ]: أنَّه قال: <span class=\"search-keys\">صَلِّ<\/span> عليهم.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> مسلم\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح مسلم\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1078\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[صحيح]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">12 -  كان إذا أتى رَجُلٌ النَّبيَّ صلَّى اللهُ عليه <span class=\"search-keys\">وسلَّم<\/span> بصَدَقَتِه قال: <span class=\"search-keys\">اللهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> عليه فأتاه أبي بصَدَقَتِه، فقال: <span class=\"search-keys\">اللهُمَّ<\/span> <span class=\"search-keys\">صَلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ أبي أوفى.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> البخاري\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح البخاري\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  6359\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[صحيح]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -  كان أَبِي من أصحابِ الشجرةِ وكان النبيُّ صلى الله عليه <span class=\"search-keys\">وسلم<\/span> إذا أتاهُ قومٌ بصدقتِهم قال <span class=\"search-keys\">اللهم<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ فلانٍ قال فأتاهُ أَبِي بصدقتِه فقال <span class=\"search-keys\">اللهم<\/span> <span class=\"search-keys\">صل<\/span> <span class=\"search-keys\">على<\/span> آلِ أبِي أَوْفَى  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أبو داود\n    <span class=\"info-subtitle\">المصدر:<\/span>  سنن أبي داود\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1590\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >سكت عنه [وقد قال في رسالته لأهل مكة كل ما سكت عنه فهو صالح]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -  كانَ أبي من أصحابِ الشَّجرةِ وَكانَ النَّبيُّ صلَّى اللَّهُ عليْهِ <span class=\"search-keys\">وسلَّمَ<\/span> إذا أتاهُ قومٌ بصدقتِهم قالَ <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ فلانٍ قالَ فأتاهُ أبي بصدقتِهِ فقالَ <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">على<\/span> آلِ أبي أَوفَى  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن أبي أوفى<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  صحيح أبي داود\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1590\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">15 -  كانَ إذا دخلَ المسجدَ قالَ ، بِسمِ اللَّهِ <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">علَى<\/span> محمَّدٍ، وإذا خرجَ قالَ : بِسمِ اللَّهِ <span class=\"search-keys\">اللَّهمَّ<\/span> <span class=\"search-keys\">صلِّ<\/span> <span class=\"search-keys\">علَى<\/span> مُحمَّدٍ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس بن مالك<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  الكلم الطيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  64\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >حسن<\/span>\n<\/div>\n--------------\n<br\/>\n<br\/><br\/>\n<a href=\"https:\/\/dorar.net\/hadith\/search?q=اللهم صل وسلم علي\">المزيد<\/a>\n"}}