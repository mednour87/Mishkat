يا أميرَ المؤمنينِ إنّي عجزتُ <span class=\"search-keys\">عن<\/span> مكاتبتِي فأعنّي فقال عليّ رضي الله عنه : ألا أُعلّمكَ كلماتِ علّمنيهن رسولُ اللهِ صلى الله عليه وسلم لو كانَ عليكَ مثْلَ جبلِ صيرَ دنانيرَ لأداه الله عنكَ قلت : بلى قال : قل <span class=\"search-keys\">اللهمّ<\/span> <span class=\"search-keys\">اكْفِنِي<\/span> <span class=\"search-keys\">بحلالِكَ<\/span> <span class=\"search-keys\">عن<\/span> <span class=\"search-keys\">حرامِكَ<\/span> <span class=\"search-keys\">وأغْننِي<\/span> <span class=\"search-keys\">بفضلكَ<\/span> عمن سواكَ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> على بن أبي طالب<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أحمد شاكر\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج المسند لشاكر\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/332\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده ضعيف<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -  <span class=\"search-keys\">عن<\/span> أبي وائلٍ، قال: أتى عليًّا رضِي اللهُ عنه رجُلٌ، فقال: يا أميرَ المُؤمِنينَ، إنِّي عجَزْتُ <span class=\"search-keys\">عن<\/span> مُكاتَبَتي فأَعِنِّي. فقال عليٌّ رضِي اللهُ عنه: ألَا أُعلِّمُكَ كلماتٍ علَّمنيهِنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، لو كان عليكَ مِثلُ جَبَلِ صِيرٍ دَنانيرَ لأَدَّاه اللهُ عنكَ، قُلتُ: بَلى، قال: قُلْ: <span class=\"search-keys\">اللَّهُمَّ<\/span> <span class=\"search-keys\">اكْفِني<\/span> <span class=\"search-keys\">بحَلالِكَ<\/span> <span class=\"search-keys\">عن<\/span> <span class=\"search-keys\">حَرامِكَ<\/span>، <span class=\"search-keys\">وأَغنِني<\/span> <span class=\"search-keys\">بفضْلِكَ<\/span> عمَّن سِواكَ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> علي بن أبي طالب<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> شعيب الأرناؤوط\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج ال