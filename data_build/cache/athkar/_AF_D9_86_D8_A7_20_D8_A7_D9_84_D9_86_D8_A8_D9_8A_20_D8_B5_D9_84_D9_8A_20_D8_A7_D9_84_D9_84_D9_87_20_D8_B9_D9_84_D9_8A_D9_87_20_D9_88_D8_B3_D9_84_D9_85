{"ahadith":{"result":"<head>\n    <link rel=\"canonical\" href=\"https:\/\/dorar.net\/dorar_api.json\">\n<\/head>\n<div class=\"hadith\" style=\"text-align:justify;\">1 -  أنَّ <span class=\"search-keys\">النبيَّ<\/span> <span class=\"search-keys\">لما<\/span> <span class=\"search-keys\">دنا<\/span> من الصفا قرأ (إِنَّ الصَّفَا وَ الْمَرْوَةَ مِنْ شَعَائِرِ <span class=\"search-keys\">اللهِ<\/span> )ابدؤُوا بما بدأ <span class=\"search-keys\">اللهُ<\/span> به ، فبدأ بالصفا فرقِىَ <span class=\"search-keys\">عليه<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> جابر بن عبدالله<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  إرواء الغليل\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1120\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >لفظ ابدؤوا شاذ<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">2 -   <span class=\"search-keys\">لمَّا<\/span> نزلت بنو قريظةَ على حُكمِ سعدِ بنِ معاذٍ, بعث رسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> إليه كان قريبًا ، فجاء على حمارٍ ، فلمَّا <span class=\"search-keys\">دنا<\/span> قال <span class=\"search-keys\">النَّبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> : قوموا إلى سيِّدِكم ، قال : فجلس إلى رسولِ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> فقال : إنَّ هؤلاء نزلوا على حُكمِك ، قال : فإنِّي أحكُمُ فيهم أن تُقتَلَ المقاتلةُ, وأن تُسبَى الذُّرِّيَّةُ ، قال : فلقد حكمتَ فيهم بحكمِ الملِكِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو سعيد الخدري<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أبو نعيم\n    <span class=\"info-subtitle\">المصدر:<\/span>  حلية الأولياء\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3\/201\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح متفق عليه [أي:بين العلماء]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">3 -  عنِ ابنِ مسعودٍ قالَ <span class=\"search-keys\">لمَّا<\/span> قُتِلَ زيدُ بنُ حارثةَ أبطأَ أسامةُ عنِ <span class=\"search-keys\">النَّبيِّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> وعلى آلِهِ <span class=\"search-keys\">وسلَّمَ<\/span> فلم يأتِهِ ثمَّ جاءهُ بعدَ ذلكَ فقامَ بينَ يديِ <span class=\"search-keys\">النَّبيِّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> وعلى آلِه <span class=\"search-keys\">وسلَّمَ<\/span> فدمَعتْ عيناهُ فبكى رسولُ <span class=\"search-keys\">اللَّهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> وعلى آلِه <span class=\"search-keys\">وسلَّمَ<\/span> فلمَّا نُزِفت عبرتُهُ قالَ <span class=\"search-keys\">النَّبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> وعلى آلِهِ <span class=\"search-keys\">وسلَّمَ<\/span> لِمَ أبطأتَ عنَّا ثمَّ جئتَ تُحزِنُنا قالَ فلمَّا كانَ الغدُ جاءهُ فلمَّا رآهُ <span class=\"search-keys\">النَّبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> وعلى آلِه <span class=\"search-keys\">وسلَّمَ<\/span> مقبِلًا قالَ إنِّي للاقٍ منكَ اليومَ ما لقيتُ منكَ أمسِ فلمَّا <span class=\"search-keys\">دنا<\/span> دمعت عينُهُ فبكى رسولُ <span class=\"search-keys\">اللَّهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> وعلى آلِه <span class=\"search-keys\">وسلَّمَ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن مسعود<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الوادعي\n    <span class=\"info-subtitle\">المصدر:<\/span>  الصحيح المسند\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  832\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح ، رجاله رجال الصحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">4 -   عنِ ابنِ عباسٍ  <span class=\"search-keys\">دَنَا<\/span> فَتَدَلَّى  قال هو محمدٌ <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> <span class=\"search-keys\">دَنَا<\/span> فَتَدَلَّى إِلَى رَبِّهِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> [عكرمة وعطاء ]<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الهيثمي\n    <span class=\"info-subtitle\">المصدر:<\/span>  مجمع الزوائد\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  7\/117\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >فيه عطاء بن السائب وقد اختلط<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">5 -  <span class=\"search-keys\">لَمَّا<\/span> انصرَفَ رسولُ <span class=\"search-keys\">اللَّهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> من تبوكَ حينَ <span class=\"search-keys\">دنا<\/span> منَ المدينةِ قال إنَّ بالمدينةِ لأقوامًا ما سِرتُم مِن مسيرٍ ولا قطعتُم واديًا إلَّا كانوا معَكم قالوا وَهُم بالمدينةِ قال نعَم حبسَهمُ العذرُ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس بن مالك<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أبو نعيم\n    <span class=\"info-subtitle\">المصدر:<\/span>  حلية الأولياء\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  8\/291\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح متفق عليه [أي:بين العلماء]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">6 -  عن أبي سعيدٍ الخدريِّ - رَضِيَ <span class=\"search-keys\">اللهُ<\/span> عنه -، أنه قال : <span class=\"search-keys\">لما<\/span> نَزَلَتْ بنو قريظةَ على حُكْمِ سعدٍ ؛ بعث رسولُ <span class=\"search-keys\">اللهِ<\/span> - <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّم<\/span> - إلى سعدٍ ؛ وكان قريبًا منه، فجاء على حِمارٍ، فلما <span class=\"search-keys\">دنا<\/span> من المسجدِ قال رسولُ <span class=\"search-keys\">اللهِ<\/span> - <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّم<\/span> - للأنصارِ : قوموا إلى سَيِّدِكم .  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو سعيد الخدري<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  هداية الرواة\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4621\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >متفق عليه، وزاد أحمد: &quot;فأنزلوه&quot; و إسناده قوي<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">7 -  أُتِي <span class=\"search-keys\">النبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> بدابَّةٍ فوقَ الحِمارِ، ودونَ البَغلِ، خَطْوُه مدَّ البصرِ، فلمَّا <span class=\"search-keys\">دنا<\/span> منه <span class=\"search-keys\">النبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> اشمأزَّ، فقال جِبْرِيلُ <span class=\"search-keys\">عليه<\/span> السلامُ: اسكُنْ، فما ركِبَكَ أحدٌ أكرَمُ على <span class=\"search-keys\">اللهِ<\/span> عزَّ وجلَّ مِن محمَّدٍ <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّمَ<\/span>.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس بن مالك<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أبو نعيم\n    <span class=\"info-subtitle\">المصدر:<\/span>  حلية الأولياء\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  7\/306\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >غريب من حديث مسعر تفرد به أحمد بن العلاء بن هلال<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">8 -  كان <span class=\"search-keys\">النبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> إذَا <span class=\"search-keys\">دَنَا<\/span> مِن منبرِهِ يومَ الجمعةِ <span class=\"search-keys\">سلَّمَ<\/span> على مَنْ عندَهُ فإذَا صعدَهُ استقبلَ النَّاسَ بوجهِهِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> العيني\n    <span class=\"info-subtitle\">المصدر:<\/span>  عمدة القاري\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  6\/318\n    <spa