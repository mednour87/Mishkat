\/span> <span class=\"search-keys\">صَلاةِ<\/span> المَغرِبِ، ورَكعَتَينِ <span class=\"search-keys\">بعدَ<\/span> <span class=\"search-keys\">صَلاةِ<\/span> العِشاءِ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> شعيب الأرناؤوط\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج المسند لشعيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  5739\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح لغيره<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">6 -   حفظت <span class=\"search-keys\">مِن<\/span> النبيِّ صلَّى اللهُ عليهِ وسلمَ  عشرَ صلواتٍ ركعتينِ قبلَ <span class=\"search-keys\">صلاةِ<\/span> الصبحِ وركعتينِ قبلَ <span class=\"search-keys\">صلاةِ<\/span> الظهرِ وركعتينِ <span class=\"search-keys\">بعدَ<\/span> <span class=\"search-keys\">صلاةِ<\/span> الظهرِ وركعتينِ <span class=\"search-keys\">بعدَ<\/span> <span class=\"search-keys\">صلاةِ<\/span> المغربِ وركعتينِ <span class=\"search-keys\">بعدَ<\/span> العشاءِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أحمد شاكر\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج المسند لشاكر\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  8\/88\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">7 -   حفظت <span class=\"search-keys\">مِن<\/span> النبيِّ صلَّى اللهُ عليهِ وسلمَ  عشرَ صلواتٍ ركعتينِ قبلَ <span class=\"search-keys\">صلاةِ<\/span> الصبحِ وركعتينِ قبلَ <span class=\"search-keys\">صلاةِ<\/span> الظهرِ وركعتينِ <span class=\"search-keys\">بعدَ<\/span> <span class=\"search-keys\">صلاةِ<\/span> الظهرِ وركعتينِ <span class=\"search-keys\">بعدَ<\/span> <span class=\"search-keys\">صلاةِ<\/span> المغربِ وركعتينِ <span class=\"search-keys\">بعدَ<\/span> العشاءِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أحمد شاكر\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج المسند لشاكر\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  8\/181\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">8 -  حَفِظتُ <span class=\"search-keys\">من<\/span> النَّبيِّ صلَّى اللهُ عليه وسلَّمَ عَشْرَ صَلَواتٍ: رَكعَتَينِ قَبلَ <span class=\"search-keys\">صَلاةِ<\/span> الصُّبحِ، ورَكعَتَينِ قَبلَ <span class=\"search-keys\">صَلاةِ<\/span> الظُّهرِ، ورَكعَتَينِ <span class=\"search-keys\">بعدَ<\/span> <span class=\"search-keys\">صَلاةِ<\/span> الظُّهرِ، ورَكعَتَينِ <span class=\"search-keys\">بعدَ<\/span> <span class=\"search-keys\">صَلاةِ<\/span> المَغرِبِ، ورَكعَتَينِ <span class=\"search-keys\">بعدَ<\/span> العِشاءِ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن عمر<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> شعيب الأرناؤوط\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج المسند لشعيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  5978 \n\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[صحيح لغيره]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">9 -   <span class=\"search-keys\">من<\/span> صلَّى <span class=\"search-keys\">صلاةَ<\/span> الصُّبحِ في الجماعةِ فكأنَّما حجَّ مع آدمَ عليه <span class=\"search-keys\">السَّلامُ<\/span> خمسين حجَّةً ، ومن صلَّى <span class=\"search-keys\">صلاةَ<\/span> الظُّهرِ في الجماعةِ فكأنَّما حجَّ مع نوحٍ عليه <span class=\"search-keys\">السَّلامُ<\/span> أربعين حجَّةً أو ثلاثين . . . .  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> -<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الصغاني\n    <span class=\"info-subtitle\">المصدر:<\/span>  الموضوعات للصغاني\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  42\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >موضوع<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">10 -   عن عليٍّ عليه <span class=\"search-keys\">السَّلامُ<\/span> قال المشْيُ خلفَها أفضلُ <span class=\"search-keys\">من<\/span> المشْيِ أمامَها كفضلِ <span class=\"search-keys\">صلاةِ<\/span> الجماعةِ على <span class=\"search-keys\">صلاةِ<\/span> الفذِّ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> -<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الصنعاني\n    <span class=\"info-subtitle\">المصدر:<\/span>  سبل السلام\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/171\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده حسن وهو موقوف<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">11 -  خرجتُ معَ أبي بَكْرٍ الصِّدِّيقِ رضيَ اللَّهُ عنهُ <span class=\"search-keys\">من<\/span> <span class=\"search-keys\">صلاةِ<\/span> العَصرِ <span class=\"search-keys\">بعدَ<\/span> وفاةِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ بليالٍ ، وعليٌّ عليهِ <span class=\"search-keys\">السَّلامُ<\/span> يَمشي إلى جانِبِهِ ، فمرَّ بحسَنِ بنِ عليٍّ يلعَبُ معَ غِلمانٍ ، فاحتملَهُ على رقبتِهِ وَهوَ يقولُ : وا بِأبي شبَهُ النَّبيِّ ليسَ شبيهًا بعليِّ ، قالَ : وعليٌّ يضحَكُ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عقبة بن الحارث<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أحمد شاكر\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج المسند لشاكر\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1\/40\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">12 -  حَديثُ: أوَّلُ <span class=\"search-keys\">مَن<\/span> قال: أمَّا <span class=\"search-keys\">بَعدُ<\/span> في الخُطبةِ داودُ عليه <span class=\"search-keys\">السَّلامُ<\/span> [يَعني حَديثَ: أوَّلُ <span class=\"search-keys\">مَن<\/span> قال: أمَّا <span class=\"search-keys\">بَعدُ<\/span> داودُ النَّبيُّ عليه <span class=\"search-keys\">السَّلامُ<\/span>، وهو فَصلُ الخِطابِ]  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو موسى الأشعري<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن حجر العسقلاني\n    <span class=\"info-subtitle\">المصدر:<\/span>  فتح الباري لابن حجر\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/470\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >في إسناده ضعف<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -  سمعتُ عمرَ بنَ الخطَّابِ يقول <span class=\"search-keys\">صلاةٌ<\/span> في المسجدِ الحرامِ أفضلُ <span class=\"search-keys\">من<\/span> مائةِ <span class=\"search-keys\">صلاةٍ<\/span> في مسجدِ النَّبيِّ عليْهِ <span class=\"search-keys\">السَّلامُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبدالله بن الزبير<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن حزم\n    <span class=\"info-subtitle\">المصدر:<\/span>  المحلى\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  7\/285\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده كالشمس في الصحة<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -   لا <span class=\"search-keys\">صلاةَ<\/span> <span class=\"search-keys\">بعدَ<\/span> <span class=\"search-keys\">صلاةِ<\/span> الفجرِ حتى تَطلُعَ الشمسُ ولا <span class=\"search-keys\">صلاةَ<\/span> <span class=\"search-keys\">بعدَ<\/span> العصرِ حتى تَغرُبَ الشمسُ ، <span class=\"search-keys\">مَن<\/span> طاف فلْيُصَلِّ. أيْ حينَ طاف  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن القيسراني\n    <span class=\"info-subtitle\">المصدر:<\/span>  ذخيرة الحفاظ\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  5\/2659\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[فيه] سعيد بن أبي راشد لم يتابع عليه<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">15 -   أنَّهُ عليهِ <span class=\"search-keys\">السلامُ<\/span> انصرف إلى بيتها فصلَّى فيهِ ركعتينِ <span class=\"search-keys\">بعد<\/span> العصرِ ، فأرسلت عائشةُ إلى أمِّ سلمةَ : ما هذهِ الصلاةُ التي صلَّاها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في بيتكَ ؟ فقالت : إنَّهُ عليهِ <span class=\"search-keys\">السلامُ<\/span> كان يُصلِّي <span class=\"search-keys\">بعد<\/span> الظهرِ ركعتينِ ، فقدم عليهِ وفدُ بني المصطلقِ في شأنِ ما صنع بهم عاملهم الوليدُ بنُ عقبةَ ، فلم يزالوا يعتذرونَ إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ حتى جاءَهُ المؤذنُ يدعوهُ إلى <span class=\"search-keys\">صلاةِ<\/span> العصرِ فصلَّى المكتوبةَ ، ثم صلَّى عندي في بيتي تلك الركعتينِ ما صلَّاهما قبلُ ولا <span class=\"search-keys\">بعدُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أم سلمة أم المؤمنين<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن الملقن\n    <span class=\"info-subtitle\">المصدر:<\/span>  البدر المنير\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3\/258\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >رواية غريبة<\/span>\n<\/div>\n--------------\n<br\/>\n<br\/><br\/>\n<a href=\"https:\/\/dorar.net\/hadith\/search?q=بعد السلام من صلاه\">المزيد<\/a>\n"}}