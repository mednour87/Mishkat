arch-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span>. فقال أبو بَكرٍ: أما إنَّكَ إن قُلتَ ذاكَ فلَقد سَمِعتُ رَسولَ <span class=\"search-keys\">اللَّهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> يَقولُ: (ما طَلَعَتِ الشَّمسُ على رَجُلٍ <span class=\"search-keys\">خَيرٍ<\/span> مِن عُمَرَ).  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو بكر الصديق<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> البزار\n    <span class=\"info-subtitle\">المصدر:<\/span>  مسند أبي بكر الصديق\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  672\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >يعتقد ضعفه<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">12 -   أنَّ <span class=\"search-keys\">النبيَّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّم<\/span> كان إذا رأى الهلالَ <span class=\"search-keys\">قال<\/span> : هلالُ <span class=\"search-keys\">خيرٍ<\/span> ورُشدٍ هلالُ <span class=\"search-keys\">خيرٍ<\/span> ورُشدٍ آمنتُ بالذي خلقك ثلاثَ مراتٍ .  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> قتادة بن دعامة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> العراقي\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج الإحياء للعراقي\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1\/428\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >مرسل<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -  أنَّه <span class=\"search-keys\">قال<\/span> العبَّاسُ: <span class=\"search-keys\">خَيرُ<\/span> هذه الأُمَّةِ وارثُ <span class=\"search-keys\">النَّبيِّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّمَ<\/span>، وعَمُّه.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> سعيد بن المسيب<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> شعيب الأرناؤوط\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج سير أعلام النبلاء\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/95\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[فيه] عبد الوهاب بن عطاء ضعفه أحمد والنسائي، وغيرهما، ووثقه آخرون، ثم هو مرسل<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -  حديثُ وابِصةَ بنِ مَعبَدٍ، عن ابنِ مسعودٍ، عن <span class=\"search-keys\">النَّبيِّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span>، <span class=\"search-keys\">قال<\/span>: تكونُ فِتنةٌ النَّائِمُ فيها <span class=\"search-keys\">خيرٌ<\/span> مِن المُضطجِعِ، والمُضطجِعُ <span class=\"search-keys\">خيرٌ<\/span> مِن القاعِدِ، والقاعِدُ <span class=\"search-keys\">خيرٌ<\/span> مِن القائِمِ...، الحديث.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> عبد الله بن مسعود<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الدارقطني\n    <span class=\"info-subtitle\">المصدر:<\/span>  علل الدارقطني\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  882\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >يرويه إسحاقُ بنُ راشِدٍ، عن عَمرِو بنِ وابِصةَ، عن أبيه.\nحدَّث به القاسِمُ بنُ غَزوانَ، عن إسحاقَ بنِ راشِدٍ.\nوتابَعه مَعمَرٌ مِن روايةِ ابنِ المُبارَكِ عنه.\nوقال عبدُ الرَّزَّاقِ في روايةِ أحمَدَ بنِ حَنبَلٍ عنه: عن مَعمَرٍ، عن رجُلٍ، عن عَمرِو بنِ وابِصةَ.\nوهذا الرَّجلُ هو إسحاقُ بنُ راشِدٍ، وفي روايةِ ابنِ أبي السَّرِيِّ العَسقَلانيِّ، عن عبدِ الرَّزَّاقِ، عن مَعمَرٍ، عن إسحاقَ بنِ راشِدٍ، عن عَمرِو بنِ وابِصةَ، عن أبيه.<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">15 -  كان رسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> في دارِنا يعرِضُ الخيلَ <span class=\"search-keys\">قال<\/span> فدخَل <span class=\"search-keys\">عليه<\/span> عُيَينةُ بنُ حِصْنٍ فقال للنَّبيِّ <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> أنت أبصرُ منِّي بالخيلِ وأنا أبصرُ بالرِّجالِ منك فقال <span class=\"search-keys\">النَّبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> فأيُّ الرِّجالِ <span class=\"search-keys\">خيرٌ<\/span> فقال رجالٌ يحمِلونَ سيوفَهم على عواتِقِهم ويعرِضونَ رماحَهم على مناسِجِ خيولِهم ويلبَسونَ البُرُودَ من أهلِ نجدٍ فقال <span class=\"search-keys\">النَّبيُّ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّم<\/span> كذَبْتَ بل <span class=\"search-keys\">خيرُ<\/span> الرِّجالِ رجالُ اليمنِ الإيمانُ يمانٍ وأكثرُ قبيلةٍ في الجنَّةَ مَذْحِجُ ومأكولُ حِمْيَرَ <span class=\"search-keys\">خيرٌ<\/span> من أكلِها وحضرَموتَ <span class=\"search-keys\">خيرٌ<\/span> من كِنْدَةَ فلعَن <span class=\"search-keys\">اللهُ<\/span> الملوكَ الأربعةَ جَمْدًا ومِسْرخًا ومِخْوَسًا وأَبْضَعةَ وأختَهم العمروة  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> معاذ بن جبل<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الهيثمي\n    <span class=\"info-subtitle\">المصدر:<\/span>  مجمع الزوائد\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  10\/47\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >رجاله ثقات إلا أن خالد بن معدان لم يسمع من معاذ‏‏<\/span>\n<\/div>\n--------------\n<br\/>\n<br\/><br\/>\n<a href=\"https:\/\/dorar.net\/hadith\/search?q=قال النبي صلي الله عليه وسلم خير\">المزيد<\/a>\n"}}