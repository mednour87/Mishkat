<span class=\"search-keys\">اللهِ<\/span> صلى <span class=\"search-keys\">الله<\/span> عليه وسلم إذا استجد ثوبًا سماه بًاسمه إما قميصا أو عمامة ثم يقول اللهم لك الحمد أنت كسوتنيه أسألك من خيره وخير ما صنع <span class=\"search-keys\">له<\/span> ، وأعوذ بك من شره وشر ما صنع <span class=\"search-keys\">له<\/span> . قال أبو نضرة : فكان أصحاب النبي صلى <span class=\"search-keys\">الله<\/span> عليه وسلم إذا لبس أحدهم ثوبًا جديدا قيل <span class=\"search-keys\">له<\/span> : <span class=\"search-keys\">تبلي<\/span> <span class=\"search-keys\">ويخلف<\/span> <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">تعالى<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو سعيد الخدري<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> أبو داود\n    <span class=\"info-subtitle\">المصدر:<\/span>  سنن أبي داود\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4020\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >سكت عنه [وقد قال في رسالته لأهل مكة كل ما سكت عنه فهو صالح]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">4 -   كان أصحابُ رسولِ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليْهِ وسلَّمَ إذا لبس أحدُهم ثوبًا جديدًا قيل <span class=\"search-keys\">له<\/span> : <span class=\"search-keys\">تُبلي<\/span> <span class=\"search-keys\">ويُخلفُ<\/span> <span class=\"search-keys\">اللهُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو نضرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن حجر العسقلاني\n    <span class=\"info-subtitle\">المصدر:<\/span>  فتح الباري لابن حجر\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  10\/292\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >إسناده صحيح<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">5 -  كانَ رَسولُ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّمَ إذا اسْتَجَدَّ ثَوْبًا سَمَّاه باسْمِه؛ إمَّا قَميصًا أو عِمامةً، ثُمَّ يقولُ: \"اللَّهُمَّ لك الحَمْدُ، أنت كَسَوْتَنيه، أَسأَلُك مِن خَيْرِه وخَيْرِ ما صُنِعَ <span class=\"search-keys\">له<\/span>، وأَعوذُ بك مِن شَرِّه وشَرِّ ما صُنِعَ <span class=\"search-keys\">له<\/span>\".\n قالَ أبو نَضْرةَ: وكانَ أصْحابُ رَسولِ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّمَ إذا لَبِسَ أحَدُهم ثَوْبًا جَديدًا قيلَ <span class=\"search-keys\">له<\/span>: <span class=\"search-keys\">تُبْلي<\/span> <span class=\"search-keys\">ويُخلِفُ<\/span> <span class=\"search-keys\">اللهُ<\/span> عَزَّ وجَلَّ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو سعيد الخدري<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> عبد الحق الإشبيلي\n    <span class=\"info-subtitle\">المصدر:<\/span>  الأحكام الوسطى\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4\/ 193\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">6 -  كان رسولُ <span class=\"search-keys\">اللهِ<\/span> صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّمَ إذا استَجَدَّ ثوبًا سَمَّاه باسمِه: إمَّا قَميصًا أو عِمامةً، ثم يقولُ: اللهُمَّ لك الحمدُ، أنتَ كَسَوْتَنيه، أسألُك من خيرِه، وخيرِ ما صُنِع <span class=\"search-keys\">له<\/span>، وأعوذُ بك من شرِّه، وشرِّ ما صُنِع <span class=\"search-keys\">له<\/span>. قال أبو نَضْرةَ: وكان أصحابُ النبيِّ صلَّى <span class=\"search-keys\">اللهُ<\/span> عليه وسلَّمَ إذا لبِسَ أحدُهم ثوبًا جديدًا قيل <span class=\"search-keys\">له<\/span>: <span class=\"search-keys\">تُبلِي<\/span> <span class=\"search-keys\">ويُخلِفُ<\/span> <span class=\"search-keys\">اللهُ<\/span> عزَّ وجَلَّ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو سعيد الخدري<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> شعيب الأرناؤوط\n    <span class=\"info-subtitle\">المصدر:<\/span>  تخريج سنن أبي داود\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  4020\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >حسن<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">7 -  ضمَّنَ <span class=\"search-keys\">اللَّهُ<\/span> خلقَهُ أربعًا : السَّماواتَ والزَّكاةَ وصومَ رمضانَ والغُسلَ منَ الجَنابةِ ، وَهُنَّ السَّرائرُ الَّتي قالَ <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">تعالى<\/span> ( يَوْمَ <span class=\"search-keys\">تُبْلَى<\/span> السَّرَائِرُ (  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو الدرداء<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> السيوطي\n    <span class=\"info-subtitle\">المصدر:<\/span>  الجامع الصغير\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  5208\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >ضعيف<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">8 -   ضمَّنَ <span class=\"search-keys\">اللَّهُ<\/span> خلقَهُ أربعًا : السَّماواتَ والزَّكاةَ وصومَ رمضانَ والغُسلَ منَ الجَنابةِ ، وَهُنَّ السَّرائرُ الَّتي قالَ <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">تعالى<\/span> ( يَوْمَ <span class=\"search-keys\">تُبْلَى<\/span> السَّرَائِرُ )  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو الدرداء<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  ضعيف الجامع\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3594\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >موضوع<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">9 -  ضَمَّنَ <span class=\"search-keys\">اللهُ<\/span> خَلْقَه أربعًا : الصلاةَ، والزكاةَ، وصومَ رمضانَ، والغسلَ من الجنابةِ، وهن السرائرُ التي قال <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">تعالى<\/span> : { يَوْمَ <span class=\"search-keys\">تُبْلَى<\/span> السَّرَائِرُ } [ الطارق : 9 ]  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو الدرداء<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  السلسلة الضعيفة\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3817\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >موضوع<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">10 -  الحُجَّاجُ والعُمَّارُ وَفدُ <span class=\"search-keys\">اللهِ<\/span>، يُعطيهم ما سَألوه، ويَستَجيبُ لهم ما دَعَوا، <span class=\"search-keys\">ويُخلِفُ<\/span> عليهم ما أنفَقوا، الدِّرهَمُ ألفُ ألفٍ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> زين الدين المناوي\n    <span class=\"info-subtitle\">المصدر:<\/span>  فيض القدير\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3\/ 405\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[فيه] ثمامة البصرى قال أبو حاتم: منكر الحديث وفيه أيضا محمد بن عبد الله بن سليمان أورده الذهبي في الضعفاء وقال ابن منده مجهول<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">11 -  الحُجَّاجُ والعُمَّارُ وَفْدُ <span class=\"search-keys\">اللهِ<\/span>، يُعطِيهم ما سأَلوا، ويستجيبُ لهم ما دَعَوْا، <span class=\"search-keys\">ويُخلِفُ<\/span> عليهم ما أنفَقوا، الدِّرهمَ ألفَ ألفٍ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الصنعاني\n    <span class=\"info-subtitle\">المصدر:<\/span>  التنوير شرح الجامع الصغير\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  5\/405\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >فيه ثمامة البصري قال البيهقي مخرجه عقيبه: وثمامة غير قوي انتهى، وقال أبو حاتم: ثمامة منكر الحديث، وفيه أيضا محمد بن عبد الله بن سيلمان قال ابن منده: مجهول<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">12 -   الحُجَّاجُ و العُمَّارُ وَفْدُ <span class=\"search-keys\">اللهِ<\/span> يُعْطِيهِم ما سألوه ، ويستجيبُ لهم ما دَعَوْا ، <span class=\"search-keys\">ويُخْلِفُ<\/span> عليهم ما أنفقوا الدِّرْهمَ أَلْفَ أَلْفٍ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس بن مالك<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  ضعيف الجامع\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2766\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >ضعيف<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -   الحُجَّاجُ والعُمَّارُ وفدُ <span class=\"search-keys\">اللهِ<\/span> ، يُعطِيهِمْ ما سَأَلُوا ، ويَستجِيبُ لَهمْ ما دَعَوا <span class=\"search-keys\">ويُخلِفُ<\/span> عليهم ما أنْفَقُوا ؛ الدِّرهمُ بِألفِ ألفِ دِرهَمٍ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أنس بن مالك<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  ضعيف الترغيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  709\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >ضعيف جداً<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -   الحُجَّاجُ والعُمَّارُ وفدُ <span class=\"search-keys\">اللهِ<\/span> عزَّ وجلَّ يُعطيهم ما سألوا وي