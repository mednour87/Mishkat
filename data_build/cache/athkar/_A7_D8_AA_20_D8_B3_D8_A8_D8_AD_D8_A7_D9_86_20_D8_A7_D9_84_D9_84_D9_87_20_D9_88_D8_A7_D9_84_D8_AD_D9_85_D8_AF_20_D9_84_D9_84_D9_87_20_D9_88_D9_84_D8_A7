ss=\"search-keys\">للَّهِ<\/span> <span class=\"search-keys\">ولا<\/span> إلَه إلَّا <span class=\"search-keys\">اللَّه<\/span> واللَّهُ أَكبرُ فإنَّهنَ مقدَّماتٌ ومنجياتٌ وَهنَ <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصَّالحاتُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن حجر العسقلاني\n    <span class=\"info-subtitle\">المصدر:<\/span>  الأمالي المطلقة\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  224\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >حسن<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">6 -  خُذوا جُنَّتَكم من النَّارِ، قولوا: <span class=\"search-keys\">سبحانَ<\/span> <span class=\"search-keys\">اللهِ<\/span>، <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span>، <span class=\"search-keys\">ولا<\/span> إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span>، واللهُ أكبَرُ؛ فإنَّهنَّ يأتينَ يومَ القيامةِ مُقَدِّماتٍ ومُعَقِّباتٍ ومُجنباتٍ، وهنَّ <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصَّالحاتُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> -<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> المقبلي\n    <span class=\"info-subtitle\">المصدر:<\/span>  المصابيح في الأحاديث المتواترة\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  609\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >متواتر معنى [كما قال في المقدمة]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">7 -   قُلْ <span class=\"search-keys\">سُبحانَ<\/span> <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span> <span class=\"search-keys\">ولا<\/span> إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> واللهُ أكبَرُ <span class=\"search-keys\">ولا<\/span> حولَ <span class=\"search-keys\">ولا<\/span> قوَّةَ إلَّا باللهِ فإنَّهنَّ <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصَّالحاتُ<\/span> وهُنَّ يَحْطُطْنَ الخطايا كما تَحُطُّ الشَّجرةُ وَرِقَها وهنَّ مِن كنوزِ الجَنَّةِ وفي روايةٍ خُذْهُنَّ قَبلَ أن يُحالَ بينَك وبينَهنَّ <span class=\"search-keys\">الباقياتِ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو الدرداء<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الهيثمي\n    <span class=\"info-subtitle\">المصدر:<\/span>  مجمع الزوائد\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  10\/93\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[روي] بإسنادين في أحدهما عمر بن راشد اليمامي وقد وثق على ضعفه وبقية رجاله رجال الصحيح‏‏<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">8 -  قل: <span class=\"search-keys\">سبحانَ<\/span> <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span> <span class=\"search-keys\">ولا<\/span> إلهَ إلا <span class=\"search-keys\">اللهُ<\/span> واللهُ أكبرُ <span class=\"search-keys\">ولا<\/span> حولَ <span class=\"search-keys\">ولا<\/span> قوةَ إلا باللهِ فإنهن <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصالحاتُ<\/span>، وهن يحططنَ الخطايا كما تحطُّ الشجرةُ ورقَها، وهنَّ من كنوزُ الجنَّةِ.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو الدرداء<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الدمياطي\n    <span class=\"info-subtitle\">المصدر:<\/span>  المتجر الرابح\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  217\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >رجاله ثقات إلا عمر بن راشد اليمامي وقد وثق.<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">9 -   قلُ : ( <span class=\"search-keys\">سبحانَ<\/span> <span class=\"search-keys\">اللهِ<\/span> ، <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span> ، <span class=\"search-keys\">ولا<\/span> إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> ، واللهُ أكْبرُ ، <span class=\"search-keys\">ولا<\/span> حولَ <span class=\"search-keys\">ولا<\/span> قُوَّةَ إلا بِاللهِ ) ، فإنَّهُنَّ <span class=\"search-keys\">الباقِياتُ<\/span> <span class=\"search-keys\">الصالِحاتُ<\/span> ، وهُنَّ يَحطُطْنَ الخطايا كما تَحُطُّ الشجرةُ ورَقَها ، وهِيَ من كُنوزِ الجنةِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو الدرداء<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الألباني\n    <span class=\"info-subtitle\">المصدر:<\/span>  ضعيف الترغيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  947\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >ضعيف<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">10 -   قلْ <span class=\"search-keys\">سبحانَ<\/span> <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span> <span class=\"search-keys\">ولا<\/span> إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> واللهُ أكبرُ ولاحولَ <span class=\"search-keys\">ولا<\/span> قوَّةَ إلَّا باللهِ فإنَّهنَّ <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصَّالحاتُ<\/span> وهنَّ يحطُطْن الخطايا كما تحطُّ الشَّجرةُ ورقَها وهي من كنوزِ الجنَّةِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو الدرداء<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> المنذري\n    <span class=\"info-subtitle\">المصدر:<\/span>  الترغيب والترهيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/355\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[روي]بإسنادين أصلحهما لا بأس به في المتابعات<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">11 -   عن النبيِّ صلَّى <span class=\"search-keys\">اللهُ<\/span> عليهِ وسلمَ  قال لجلسائِه : خذوا جُنَّتكم من النارِ ، قولوا : <span class=\"search-keys\">سبحانَ<\/span> <span class=\"search-keys\">اللهِ<\/span> ، <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span> ، <span class=\"search-keys\">ولا<\/span> إلهَ إلا <span class=\"search-keys\">اللهُ<\/span> ، واللهُ أكبرُ ، <span class=\"search-keys\">ولا<\/span> حولَ <span class=\"search-keys\">ولا<\/span> قوةَ إلا باللهِ ، فإنهنَّ المقدَّمات وهنَّ المعقباتُ وهن <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصالحاتُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن أبي حاتم \n    <span class=\"info-subtitle\">المصدر:<\/span>  تاريخ بغداد\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  9\/336\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >منكر<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">12 -   أين أنتَ من قولِ <span class=\"search-keys\">سُبحانَ<\/span> <span class=\"search-keys\">الله<\/span> <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span> <span class=\"search-keys\">ولا<\/span> إله إلا <span class=\"search-keys\">اللهُ<\/span> واللهُ أكبرُ <span class=\"search-keys\">ولا<\/span> حولَ <span class=\"search-keys\">ولا<\/span> قوة إلا باللهِ العليّ العظيمِ ، فإنّهنّ يَحطُطنَ الخطايا كما تَحط الشجرةُ ورقها ، وهي <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصالحاتُ<\/span> وهي من كنوزِ الجنةِ  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو الدرداء<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> ابن القيسراني\n    <span class=\"info-subtitle\">المصدر:<\/span>  ذخيرة الحفاظ\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/1069\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[فيه] عمر اليمامي متروك<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">13 -   خذُوا جُنَّتَكم قالوا يا رسولَ <span class=\"search-keys\">اللهِ<\/span> عدوٌّ حضر قال لا ولكن جُنَّتُكم من النَّارِ قولوا <span class=\"search-keys\">سبحانَ<\/span> <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span> <span class=\"search-keys\">ولا<\/span> إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span> واللهُ أكبرُ فإنَّهنَّ يأتين يومَ القيامةِ مجنِّباتٍ ومعقِّباتٍ وهنَّ <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصَالحاتُ<\/span>  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> المنذري\n    <span class=\"info-subtitle\">المصدر:<\/span>  الترغيب والترهيب\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2\/355\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[إسناده صحيح أو حسن أو ما قاربهما]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -  خُذُوا جُنَّتَكُم. قُلْنا: يا رسولَ <span class=\"search-keys\">اللهِ<\/span>، أَمِنْ عَدُوٍّ قد حَضَرَ؟ قال: لا، جُنَّتُكُم مِنَ النَّارِ، قُولوا: <span class=\"search-keys\">سُبحانَ<\/span> <span class=\"search-keys\">اللهِ<\/span>، <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للهِ<\/span>، <span class=\"search-keys\">ولا<\/span> إلهَ إلَّا <span class=\"search-keys\">اللهُ<\/span>، واللهُ أكبرُ؛ يأتِينَ يومَ القيامةِ مُقَدِّماتٍ ومُعَقِّباتٍ ومُجَنِّباتٍ، وهنَّ <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصَّالِحاتُ<\/span>.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> العقيلي \n    <span class=\"info-subtitle\">المصدر:<\/span>  الضعفاء الكبير\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  3\/18\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >[فيه] عبد العزيز بن مسلم في حديثه بعض الوهم<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">15 -  خُذوا جُنَّتَكُمْ، قُلْنا يا رسولَ <span class=\"search-keys\">اللَّهِ<\/span>، مِن عدُوٍّ حضَرَ؟ قالَ: لا، بَلْ جُنَّتُكُمْ مِنَ النَّارِ قولُ <span class=\"search-keys\">سُبحانَ<\/span> <span class=\"search-keys\">اللَّهِ<\/span>، <span class=\"search-keys\">والحمدُ<\/span> <span class=\"search-keys\">للَّهِ<\/span>، <span class=\"search-keys\">ولا<\/span> إلهَ إلَّا <span class=\"search-keys\">اللَّهُ<\/span>، واللَّهُ أكبرُ؛ فإنَّها تأتي يومَ القيامةِ مُنْجِيَاتٍ ومُقدَّماتٍ، وهُنَّ <span class=\"search-keys\">الباقياتُ<\/span> <span class=\"search-keys\">الصَّالحاتُ<\/span>.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو هريرة<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الحاكم\n    <span class=\"info-subtitle\">المصدر:<\/span>  تفسير الباقيات الصالحات\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  1\/23\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح على شرط مسلم ولم يخرجاه<\/span>\n<\/div>\n--------------\n<br\/>\n<br\/><br\/>\n<a href=\"https:\/\/dorar.net\/hadith\/search?q=الباقيات الصالحات سبحان الله والحمد لله ولا\">المزيد<\/a>\n"}}