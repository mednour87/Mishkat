    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >صحيح لكن من حديث البراء [لا من حديث ذي الغرة]<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">14 -  <span class=\"search-keys\">قال<\/span> رسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّمَ<\/span>: <span class=\"search-keys\">مَن<\/span> يُرائي يُرائي <span class=\"search-keys\">اللهُ<\/span> به، ومَن يُسَمِّعْ يُسَمِّعِ <span class=\"search-keys\">اللهُ<\/span> به. <span class=\"search-keys\">قال<\/span>: وقال رسولُ <span class=\"search-keys\">اللهِ<\/span> <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللهُ<\/span> <span class=\"search-keys\">عليه<\/span> <span class=\"search-keys\">وسلَّمَ<\/span>: <span class=\"search-keys\">مَن<\/span> <span class=\"search-keys\">لا<\/span> يرحَمُ النَّاسَ <span class=\"search-keys\">لا<\/span> يرحَمُه <span class=\"search-keys\">اللهُ<\/span>.  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> أبو سعيد الخدري<\/span>\n    <span class=\"info-subtitle\">المحدث:<\/span> الترمذي\n    <span class=\"info-subtitle\">المصدر:<\/span>  سنن الترمذي\n    <span class=\"info-subtitle\">الصفحة أو الرقم:<\/span>  2381\n    <span class=\"info-subtitle\">خلاصة حكم المحدث:<\/span>  <span >حسن صحيح من هذا الوجه<\/span>\n<\/div>\n--------------\n<br\/>\n<div class=\"hadith\" style=\"text-align:justify;\">15 -  بايعَ النَّبيُّ <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> أعرابيًّا فلمَّا خرجَ <span class=\"search-keys\">من<\/span> عندِهِ <span class=\"search-keys\">قالَ<\/span> <span class=\"search-keys\">لَهُ<\/span> عليٌّ إن ماتَ النَّبيُّ <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> فمن تأخذُ حقَّكَ <span class=\"search-keys\">قالَ<\/span> <span class=\"search-keys\">لا<\/span> أدري <span class=\"search-keys\">قالَ<\/span> ارجِع فاسألهُ فرجعَ الأعرابيُّ فسألَهُ فقالَ النَّبيُّ <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> <span class=\"search-keys\">مِن<\/span> أبي بَكرٍ فلمَّا خرجَ <span class=\"search-keys\">قالَ<\/span> <span class=\"search-keys\">لَهُ<\/span> عليٌّ فإن ماتَ أبو بَكرٍ فمن يأخذُ حقَّكَ <span class=\"search-keys\">قالَ<\/span> <span class=\"search-keys\">لا<\/span> أدري <span class=\"search-keys\">قالَ<\/span> ارجِع فاسألهُ فقالَ <span class=\"search-keys\">من<\/span> عمرَ فلمَّا خرجَ <span class=\"search-keys\">قالَ<\/span> <span class=\"search-keys\">لَهُ<\/span> عليٌّ فإن ماتَ عمرُ <span class=\"search-keys\">قالَ<\/span> <span class=\"search-keys\">لا<\/span> أدري <span class=\"search-keys\">قال<\/span> ارجع فاسأله <span class=\"search-keys\">قالَ<\/span> فرجعَ فسألَهُ فقالَ النَّبيُّ <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> <span class=\"search-keys\">من<\/span> عُثمانَ فلمَّا خرجَ <span class=\"search-keys\">قالَ<\/span> <span class=\"search-keys\">لَهُ<\/span> عليٌّ فإن ماتَ فمن يأخذُ حقَّكَ <span class=\"search-keys\">قالَ<\/span> <span class=\"search-keys\">لا<\/span> أدري <span class=\"search-keys\">قالَ<\/span> ارجع فاسألهُ فقالَ النَّبيُّ <span class=\"search-keys\">صلَّى<\/span> <span class=\"search-keys\">اللَّهُ<\/span> <span class=\"search-keys\">عليهِ<\/span> <span class=\"search-keys\">وسلَّمَ<\/span> إن ماتَ عثمانُ فإنِ استطعتَ أن تموتَ فمُت  .<\/div>\n\n<div class=\"hadith-info\">\n    <span class=\"info-subtitle\">الراوي:<\/span> سهل 